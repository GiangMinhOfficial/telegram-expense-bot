{
  "name": "telegram-expense-bot",
  "version": "1.0.0",
  "description": "Ghi chi tiêu vào Excel trên OneDrive qua một tin nhắn Telegram",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "spike": "node scripts/spike.mjs",
    "spike:prepare": "node scripts/make-test-copy.mjs",
    "spike:cleanup": "node scripts/drop-test-copy.mjs",
    "setup:telegram": "node scripts/setup-telegram.mjs",
    "setup:note": "node scripts/setup-note.mjs",
    "verify:card": "node scripts/verify-card.mjs"
  },
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
